{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "advisorModel": "opus",
  "agentPushNotifEnabled": true,
  "alwaysThinkingEnabled": true,
  "askUserQuestionTimeout": "never",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "autoCompactEnabled": true,
  "autoContinueAtUsageLimit": true,
  "autoDreamEnabled": true,
  "autoMemoryEnabled": false,
  "autoScrollEnabled": true,
  "autoUpdatesChannel": "latest",
  "editorMode": "normal",
  "effortLevel": "high",
  "enableWorkflows": true,
  "enabledPlugins": {
    "andrej-karpathy-skills@karpathy-skills": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "context-handoff@sam-tools": false,
    "context-usage@sam-tools": true,
    "document-skills@anthropic-agent-skills": true,
    "figma@claude-plugins-official": true,
    "language-reminder@sam-tools": true,
    "skill-creator@claude-plugins-official": true,
    "tsgo-lsp@sam-tools": true
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "0",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "20",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "2",
    "ENABLE_LSP_TOOL": "1",
    "ENABLE_TOOL_SEARCH": "1"
  },
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "repo": "anthropics/skills",
        "source": "github"
      }
    },
    "karpathy-skills": {
      "source": {
        "repo": "forrestchang/andrej-karpathy-skills",
        "source": "github"
      }
    },
    "sam-tools": {
      "source": {
        "repo": "hansamlin/claude-config",
        "source": "github"
      }
    }
  },
  "feedbackDrafts": "notify",
  "language": "繁體中文（台灣用語）",
  "model": "opus",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "medium"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    }
  },
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "Bash",
      "Read(/__CLAUDE_DIR__/**)",
      "mcp__chrome-devtools__list_pages",
      "mcp__chrome-devtools__navigate_page",
      "mcp__chrome-devtools__take_snapshot",
      "mcp__chrome-devtools__take_screenshot",
      "mcp__chrome-devtools__evaluate_script",
      "mcp__chrome-devtools__list_console_messages",
      "mcp__chrome-devtools__click",
      "mcp__chrome-devtools__press_key",
      "WebSearch",
      "mcp__claude-in-chrome"
    ],
    "ask": [],
    "defaultMode": "auto",
    "deny": []
  },
  "preferredNotifChannel": "auto",
  "remoteControlAtStartup": false,
  "showClearContextOnPlanAccept": true,
  "skipAutoPermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "statusLine": {
    "command": "bash __CLAUDE_DIR__/statusline.sh",
    "refreshInterval": 5,
    "type": "command"
  },
  "switchModelsOnFlag": false,
  "teammateMode": "in-process",
  "theme": "auto",
  "timeFormat": "24-hour",
  "tui": "fullscreen",
  "verbose": false,
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "voiceEnabled": false,
  "worktree": {
    "baseRef": "head"
  }
}
